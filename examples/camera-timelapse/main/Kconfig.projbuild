menu "ESPKit camera timelapse"

    choice ESPKIT_CAMERA_TIMELAPSE_PIN_PRESET
        prompt "Camera pin map preset"
        default ESPKIT_CAMERA_TIMELAPSE_PRESET_ESP32S3_EYE
        help
            The ESP32-S3-EYE map is also used by common ESP32-S3-WROOM CAM /
            Freenove-style boards. Choose Custom and edit the GPIO values
            below if your module is wired differently.

        config ESPKIT_CAMERA_TIMELAPSE_PRESET_ESP32S3_EYE
            bool "ESP32-S3-EYE / common WROOM CAM"
        config ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
            bool "Custom pin map"
    endchoice

    config ESPKIT_CAMERA_TIMELAPSE_PIN_PWDN
        int "PWDN GPIO (-1 if unused)"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default -1
        range -1 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_RESET
        int "RESET GPIO (-1 if unused)"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default -1
        range -1 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_XCLK
        int "XCLK GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 15
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_SIOD
        int "SCCB SDA (SIOD) GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 4
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_SIOC
        int "SCCB SCL (SIOC) GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 5
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D0
        int "Y2 / D0 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 11
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D1
        int "Y3 / D1 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 9
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D2
        int "Y4 / D2 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 8
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D3
        int "Y5 / D3 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 10
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D4
        int "Y6 / D4 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 12
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D5
        int "Y7 / D5 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 18
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D6
        int "Y8 / D6 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 17
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_D7
        int "Y9 / D7 GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 16
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_VSYNC
        int "VSYNC GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 6
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_HREF
        int "HREF GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 7
        range 0 48
    config ESPKIT_CAMERA_TIMELAPSE_PIN_PCLK
        int "PCLK GPIO"
        depends on ESPKIT_CAMERA_TIMELAPSE_PRESET_CUSTOM
        default 13
        range 0 48

    choice ESPKIT_CAMERA_TIMELAPSE_FRAME_SIZE
        prompt "JPEG frame size"
        default ESPKIT_CAMERA_TIMELAPSE_FRAMESIZE_VGA
        help
            VGA is the usual still size on this board.

        config ESPKIT_CAMERA_TIMELAPSE_FRAMESIZE_QVGA
            bool "QVGA (320x240)"
        config ESPKIT_CAMERA_TIMELAPSE_FRAMESIZE_VGA
            bool "VGA (640x480)"
    endchoice

    config ESPKIT_CAMERA_TIMELAPSE_JPEG_QUALITY
        int "JPEG quality (lower is better, 4-20)"
        default 12
        range 4 20

    choice ESPKIT_CAMERA_TIMELAPSE_DEFAULT_MODE
        prompt "Default capture mode"
        default ESPKIT_CAMERA_TIMELAPSE_MODE_TIMELAPSE
        help
            The HTTP settings page can switch this at runtime.

        config ESPKIT_CAMERA_TIMELAPSE_MODE_TIMELAPSE
            bool "Timelapse (period capture)"
        config ESPKIT_CAMERA_TIMELAPSE_MODE_MOTION
            bool "Motion (store a still when the score crosses the threshold)"
    endchoice

    config ESPKIT_CAMERA_TIMELAPSE_INTERVAL_S
        int "Timelapse interval (seconds)"
        default 10
        range 1 3600

    config ESPKIT_CAMERA_TIMELAPSE_MOTION_PERIOD_MS
        int "Motion sample period (milliseconds)"
        default 500
        range 100 5000

    config ESPKIT_CAMERA_TIMELAPSE_PIXEL_THRESHOLD
        int "Motion pixel difference threshold"
        default 24
        range 1 64
        help
            Absolute grayscale difference after optional brightness
            compensation. Differences below this are treated as noise.

    config ESPKIT_CAMERA_TIMELAPSE_CHANGED_PERMILLE
        int "Motion changed-pixel threshold (per thousand)"
        default 40
        range 1 500
        help
            40 means 4% of downscaled pixels must change to count as motion.

    config ESPKIT_CAMERA_TIMELAPSE_COOLDOWN_MS
        int "Motion cooldown (milliseconds)"
        default 5000
        range 0 60000

    config ESPKIT_CAMERA_TIMELAPSE_RING_SLOTS
        int "PSRAM ring buffer slots"
        default 24
        range 4 32
        help
            Oldest stills are overwritten when the ring is full. There is no
            SD card path in this example; stills are lost on reboot.

    config ESPKIT_CAMERA_TIMELAPSE_LED_GPIO
        int "Onboard WS2812 GPIO"
        default 48
        range 0 48

    config ESPKIT_CAMERA_TIMELAPSE_LED_COUNT
        int "WS2812 LED count"
        default 1
        range 1 16

    config ESPKIT_CAMERA_TIMELAPSE_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Leave empty in the committed defaults. Put the SSID in an untracked
            sdkconfig.defaults.local or sdkconfig.local, or provision it into
            the espkit NVS namespace.

    config ESPKIT_CAMERA_TIMELAPSE_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            WPA2-PSK password. Never commit this value. It is not logged.

    config ESPKIT_CAMERA_TIMELAPSE_REFUSE_GRACE_S
        int "Seconds to keep a refused OTA image reachable before rollback"
        default 8
        range 0 30

endmenu
