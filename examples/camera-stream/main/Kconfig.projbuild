menu "ESPKit camera stream"

    choice ESPKIT_CAMERA_STREAM_PIN_PRESET
        prompt "Camera pin map preset"
        default ESPKIT_CAMERA_STREAM_PRESET_ESP32S3_EYE
        help
            The ESP32-S3-EYE map is also used by common ESP32-S3-WROOM CAM /
            Freenove-style boards. Choose Custom and edit the GPIO values
            below if your module is wired differently.

        config ESPKIT_CAMERA_STREAM_PRESET_ESP32S3_EYE
            bool "ESP32-S3-EYE / common WROOM CAM"
        config ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
            bool "Custom pin map"
    endchoice

    config ESPKIT_CAMERA_STREAM_PIN_PWDN
        int "PWDN GPIO (-1 if unused)"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default -1
        range -1 48
    config ESPKIT_CAMERA_STREAM_PIN_RESET
        int "RESET GPIO (-1 if unused)"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default -1
        range -1 48
    config ESPKIT_CAMERA_STREAM_PIN_XCLK
        int "XCLK GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 15
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_SIOD
        int "SCCB SDA (SIOD) GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 4
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_SIOC
        int "SCCB SCL (SIOC) GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 5
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D0
        int "Y2 / D0 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 11
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D1
        int "Y3 / D1 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 9
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D2
        int "Y4 / D2 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 8
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D3
        int "Y5 / D3 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 10
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D4
        int "Y6 / D4 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 12
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D5
        int "Y7 / D5 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 18
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D6
        int "Y8 / D6 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 17
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_D7
        int "Y9 / D7 GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 16
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_VSYNC
        int "VSYNC GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 6
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_HREF
        int "HREF GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 7
        range 0 48
    config ESPKIT_CAMERA_STREAM_PIN_PCLK
        int "PCLK GPIO"
        depends on ESPKIT_CAMERA_STREAM_PRESET_CUSTOM
        default 13
        range 0 48

    choice ESPKIT_CAMERA_STREAM_FRAME_SIZE
        prompt "JPEG frame size"
        default ESPKIT_CAMERA_STREAM_FRAMESIZE_VGA
        help
            VGA is the usual preview size on this board. Expect about 5-6
            frames per second over HTTP. QVGA is smoother.

        config ESPKIT_CAMERA_STREAM_FRAMESIZE_QVGA
            bool "QVGA (320x240)"
        config ESPKIT_CAMERA_STREAM_FRAMESIZE_VGA
            bool "VGA (640x480)"
    endchoice

    config ESPKIT_CAMERA_STREAM_JPEG_QUALITY
        int "JPEG quality (lower is better, 4-20)"
        default 12
        range 4 20

    config ESPKIT_CAMERA_STREAM_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Leave empty in the committed defaults. Put the SSID in an untracked
            sdkconfig.defaults.local or sdkconfig.local, or provision it into
            the espkit NVS namespace.

    config ESPKIT_CAMERA_STREAM_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            WPA2-PSK password. Never commit this value. It is not logged.

endmenu
